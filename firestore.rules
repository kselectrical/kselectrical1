rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user is a registered admin
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'kaushindrasingh04@gmail.com' || 
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    // Public configurations & reviews
    match /services/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /business_config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /offline_reviews/{document} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // Products collection (Marketplace)
    match /products/{document} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection (Marketplace)
    match /orders/{document} {
      allow read, write: if true;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow create: if true; // Allow guests to book
      allow read, update: if true;
      allow delete: if true;
    }

    // Customers profiles
    match /Customers/{phone} {
      allow read, write: if true;
    }

    // Admins list
    match /admins/{email} {
      allow read, write: if true;
    }

    // Fallback rule for safety
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
