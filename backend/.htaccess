RewriteEngine On

# Force HTTPS redirect - Compatible with InfinityFree reverse proxies
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:CF-Visitor} !{"scheme":"https"}
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Local SEO URL Rewrite rules for KS Electrical Services
# Maps /ac-service-in-gaur-city-1 to /home.php?service=ac-service&location=gaur-city-1
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9-]+)-in-([a-zA-Z0-9-]+)/?$ home.php?service=$1&location=$2 [L,QSA]

# Maps /ac-service to /home.php?service=ac-service
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9-]+)/?$ home.php?service=$1 [L,QSA]
