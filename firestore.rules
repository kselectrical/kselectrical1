rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == 'kaushindrasingh04@gmail.com' ||
         request.auth.token.email == 'kselectrical004@gmail.com' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    // ─── Public Catalog ─────────────────────────────────────────────────────
    match /services/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Branding & Configuration ───────────────────────────────────────────
    match /branding/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /business_config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Customer Profiles (CRITICAL FIX) ───────────────────────────────────
    // Visitors and customers need to create & update their customer directory record
    // when submitting doorstep service bookings, and admin needs to view all profiles.
    match /Customers/{phone} {
      allow read, write: if true;
    }

    // ─── Bookings (Online Reservations) ─────────────────────────────────────
    // Guests and customers must be able to submit bookings without auth friction.
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // ─── Invoices (Tax Invoices / Bills) ────────────────────────────────────
    match /invoices/{document} {
      allow read, write: if true;
    }

    match /invoice_history/{document} {
      allow read, write: if true;
    }

    // ─── Reviews ─────────────────────────────────────────────────────────────
    match /offline_reviews/{document} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ─── Marketplace ─────────────────────────────────────────────────────────
    match /products/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{document} {
      allow read, write: if true;
    }

    // ─── Admin Management & Audit Logs ──────────────────────────────────────
    match /admins/{email} {
      allow read, write: if true;
    }

    match /audit_logs/{document} {
      allow read, write: if true;
    }

    match /price_history/{document} {
      allow read, write: if true;
    }

    match /technicians/{document} {
      allow read, write: if true;
    }

    // ─── Fallback Safety Net ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
